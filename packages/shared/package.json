{
  "name": "@melaverse/shared",
  "version": "0.1.0",
  "description": "Shared types, Zod schemas, and message protocol for MelaVerse Nepal",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
