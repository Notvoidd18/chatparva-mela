# Chatparva Mela Web Client — Environment Variables
# Copy this file to .env and fill in real values

# WebSocket URL for the Colyseus game server
VITE_SERVER_URL=ws://localhost:2567

# HTTP URL for REST endpoints (health check etc.)
VITE_SERVER_URL_HTTP=http://localhost:2567

# Human-readable app name shown in the UI
VITE_APP_NAME=Chatparva Mela
